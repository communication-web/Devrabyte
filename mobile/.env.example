# The URL of your deployed Devrabyte web app (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://your-domain.vercel.app
EXPO_PUBLIC_API_URL=https://your-domain.vercel.app

# Brand name shown in the app header
EXPO_PUBLIC_BRAND_NAME=House of Jade

# Powered-by label shown in footer/about
EXPO_PUBLIC_POWERED_BY=Devrabyte

# Your EAS project ID (from `eas init`)
EAS_PROJECT_ID=REPLACE_WITH_YOUR_EAS_PROJECT_ID
